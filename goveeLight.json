{ "name":"Govee Light",
  "manufacturer":"Govee",
  "type":"LIGHT",
  "version":1,
  "persistedvariables":{
    "GoveeApiKey":""
  },
  "register":{
    "registerheadertext":"Govee Light",
    "registerdescription":"Please enter your Govee API-Key.\nGet it in the Govee Home app: Profile > About Us > Apply for API Key.",
    "command": {"type": "static", "command": ".", "queryresult": "$.*"}
  },
  "discover":{
    "welcomeheadertext":"Govee Light",
    "welcomedescription":"Searching your Govee devices...",
    "initcommandset":[
      {"label":"", "type":"static", "command":"$RegistrationCode", "queryresult":"",
        "evalwrite":[{"variable":"GoveeApiKey","value":"DYNAMIK \"$Result\""}]
      }
    ],
    "command": {"type":"http-rest", "command":"DYNAMIK let req = {\"verb\":\"get\", \"call\":\"https://openapi.api.govee.com/router/api/v1/user/devices\", \"headers\":{\"Govee-API-Key\":\"$GoveeApiKey\"}}; req", "queryresult":"$.data.*"}
  },
  "template" : {
    "name":"Govee Light",
    "dynamicname":"DYNAMIK_INST_START DYNAMIK JSON.parse(\"$Result\").deviceName DYNAMIK_INST_END",
    "dynamicid":"DYNAMIK_INST_START DYNAMIK \"Govee \" + JSON.parse(\"$Result\").device DYNAMIK_INST_END",

    "variables":{
      "GoveeApiKey":"$GoveeApiKey",
      "DeviceId":"DYNAMIK_INST_START DYNAMIK JSON.parse(\"$Result\").device DYNAMIK_INST_END",
      "Sku":"DYNAMIK_INST_START DYNAMIK JSON.parse(\"$Result\").sku DYNAMIK_INST_END",
      "Brightness":"100",
      "SavedBright":"100",
      "ColorRgb":"16777215",
      "SwitchedOn":false,
      "SupportsBrightness":"DYNAMIK_INST_START DYNAMIK JSON.parse(\"$Result\").capabilities.some(c => c.type === 'devices.capabilities.range' && c.instance === 'brightness') DYNAMIK_INST_END",
      "SupportsColor":"DYNAMIK_INST_START DYNAMIK JSON.parse(\"$Result\").capabilities.some(c => c.type === 'devices.capabilities.color_setting' && c.instance === 'colorRgb') DYNAMIK_INST_END"
    },

    "switches":{
      "POWER" : {"label":"On", "listen":"SwitchedOn", "evaldo":[{"test":"DYNAMIK $Result", "then":"SWITCHON", "or":"SWITCHOFF"}]}
    },
    "sliders":{
        "BRIGHTNESS": {"label":"Brightness", "unit" : "%", "listen" : "Brightness", "evaldo":[{"test":true, "then":"BRIGHTNESSCHANGE", "or":""}]}
    },
    "buttons":{
        "POWER ON": {"label":"", "type":"static", "command":"", "evaldo":[{"test":true,"then":"__INITIALISE", "or":""}]},
        "POWER OFF": {"label":"", "type":"static", "command":"", "evaldo":[{"test":true,"then":"__CLEANUP", "or":""}]},

        "SWITCHON": {"label":"", "type":"http-rest", "command":"DYNAMIK let req = {\"verb\":\"post\", \"call\":\"https://openapi.api.govee.com/router/api/v1/device/control\", \"headers\":{\"Govee-API-Key\":\"$GoveeApiKey\", \"Content-Type\":\"application/json\"}, \"message\":{\"requestId\":\"1\", \"payload\":{\"sku\":\"$Sku\", \"device\":\"$DeviceId\", \"capability\":{\"type\":\"devices.capabilities.on_off\", \"instance\":\"powerSwitch\", \"value\":1}}}}; req", "evalwrite":[{"variable":"SwitchedOn","value":true}, {"variable":"Brightness","value":"DYNAMIK Math.round($SavedBright)"}]},

        "SWITCHOFF": {"label":"", "type":"http-rest", "command":"DYNAMIK let req = {\"verb\":\"post\", \"call\":\"https://openapi.api.govee.com/router/api/v1/device/control\", \"headers\":{\"Govee-API-Key\":\"$GoveeApiKey\", \"Content-Type\":\"application/json\"}, \"message\":{\"requestId\":\"1\", \"payload\":{\"sku\":\"$Sku\", \"device\":\"$DeviceId\", \"capability\":{\"type\":\"devices.capabilities.on_off\", \"instance\":\"powerSwitch\", \"value\":0}}}}; req", "evalwrite":[{"variable":"SwitchedOn","value":false}, {"variable":"SavedBright","value":"DYNAMIK Math.round($Brightness)"}, {"variable":"Brightness","value":0}]},

        "BRIGHTNESSCHANGE": {"label":"", "type":"static", "command":"", "evaldo":[{"test":"DYNAMIK $SupportsBrightness", "then":"__BRIGHTNESSCHANGE_SEND", "or":""}]},
        "__BRIGHTNESSCHANGE_SEND": {"label":"", "type":"http-rest", "command":"DYNAMIK let req = {\"verb\":\"post\", \"call\":\"https://openapi.api.govee.com/router/api/v1/device/control\", \"headers\":{\"Govee-API-Key\":\"$GoveeApiKey\", \"Content-Type\":\"application/json\"}, \"message\":{\"requestId\":\"1\", \"payload\":{\"sku\":\"$Sku\", \"device\":\"$DeviceId\", \"capability\":{\"type\":\"devices.capabilities.range\", \"instance\":\"brightness\", \"value\":Math.round($Brightness)}}}}; req"},

        "__COLORSET_SEND": {"label":"", "type":"http-rest", "command":"DYNAMIK let req = {\"verb\":\"post\", \"call\":\"https://openapi.api.govee.com/router/api/v1/device/control\", \"headers\":{\"Govee-API-Key\":\"$GoveeApiKey\", \"Content-Type\":\"application/json\"}, \"message\":{\"requestId\":\"1\", \"payload\":{\"sku\":\"$Sku\", \"device\":\"$DeviceId\", \"capability\":{\"type\":\"devices.capabilities.color_setting\", \"instance\":\"colorRgb\", \"value\":Number($ColorRgb)}}}}; req"}
    },

    "directories":{
      "Colors": {"label":"Color Picker", "feeders": {
          "color":{"label":"", "commandset": [{"type":"static", "command": "[{\"name\":\"Red\",\"rgb\":16711680,\"imageurl\":\"https://raw.githubusercontent.com/ichrui/NeeoHueProDriver/main/Resources/Col_Red.jpg\"}, {\"name\":\"Orange\",\"rgb\":16747520,\"imageurl\":\"https://raw.githubusercontent.com/ichrui/NeeoHueProDriver/main/Resources/Col_Orange.jpg\"}, {\"name\":\"Light Orange\",\"rgb\":16757606,\"imageurl\":\"https://raw.githubusercontent.com/ichrui/NeeoHueProDriver/main/Resources/Col_Light_Orange.jpg\"}, {\"name\":\"Warm White\",\"rgb\":16774373,\"imageurl\":\"https://raw.githubusercontent.com/ichrui/NeeoHueProDriver/main/Resources/Col_Warm_White.jpg\"}, {\"name\":\"Full White\",\"rgb\":16777215,\"imageurl\":\"https://raw.githubusercontent.com/ichrui/NeeoHueProDriver/main/Resources/Col_Full_White.jpg\"}, {\"name\":\"Cold White\",\"rgb\":14478335,\"imageurl\":\"https://raw.githubusercontent.com/ichrui/NeeoHueProDriver/main/Resources/Col_Cold_White.jpg\"}, {\"name\":\"Green\",\"rgb\":51290,\"imageurl\":\"https://raw.githubusercontent.com/ichrui/NeeoHueProDriver/main/Resources/Col_Green.jpg\"}, {\"name\":\"Light Blue\",\"rgb\":8900346,\"imageurl\":\"https://raw.githubusercontent.com/ichrui/NeeoHueProDriver/main/Resources/Col_Light_Blue.jpg\"}, {\"name\":\"Deep Blue\",\"rgb\":255,\"imageurl\":\"https://raw.githubusercontent.com/ichrui/NeeoHueProDriver/main/Resources/Col_Deep_Blue.jpg\"}, {\"name\":\"Pink\",\"rgb\":16750270,\"imageurl\":\"https://raw.githubusercontent.com/ichrui/NeeoHueProDriver/main/Resources/Col_Pink.jpg\"}]", "queryresult":"$.*", "itemtype": "tile", "itemaction":"colorSet", "itemimage":"DYNAMIK JSON.parse(\"$Result\").imageurl", "evalwrite":[{"variable":"ColorRgb","value":"DYNAMIK JSON.parse(\"$Result\").rgb"}]}]},
          "colorSet":{"label":"", "commandset": [{"type":"static", "command":".", "evaldo":[{"test":"DYNAMIK $SupportsColor", "then":"__COLORSET_SEND", "or":""}]}]}
        }
      }
    }
  }
}
